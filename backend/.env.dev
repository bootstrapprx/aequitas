# .env.dev - Configuration for local development (backend on host)

# PostgreSQL connection (running in Docker)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=chartforge_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Application Settings
SECRET_KEY=a_very_secret_key_for_development
APP_ENV=development
ALLOW_MANUAL_DATA_FALLBACK=True

# --- Superuser Settings (new) ---
# Preferred new naming (will fallback to FIRST_SUPERUSER if not set)
DEFAULT_SUPERUSER_EMAIL=actpm@aequitas.com
DEFAULT_SUPERUSER_PASSWORD=c9r7b235

# --- Registration Settings (new) ---
ALLOW_PUBLIC_SIGNUP=true

# --- Stripe Settings (optional, uses mock mode if not set) ---
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MOCK_MODE=true

# Ollama connection (running in Docker)
OLLAMA_BASE_URL=http://localhost:11434
ORGANIZER_MODEL_NAME=qwen:latest

# QuickBooks Online Credentials (leave blank if not used in dev)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/api/v1/qbo/callback

