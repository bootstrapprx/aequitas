DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/postgres
SECRET_KEY=replace-with-a-random-32-byte-secret
APP_ENV=development
ALLOW_MANUAL_DATA_FALLBACK=False
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b-base
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
ORGANIZER_MODEL_NAME=qwen2.5-coder:1.5b-base
OLLAMA_BASE_URL=http://ollama:11434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forge

# Cloudflare AI
AI_PROVIDER=ollama
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OAuth Providers (optional - for social login)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google
ENABLE_GOOGLE_AUTH=true

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback/microsoft
MICROSOFT_TENANT=common

# Apple Sign-In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:5173/auth/callback/apple

# OAuth state signing secret (shared by all providers)
OAUTH_STATE_SECRET=

# AUTH RECOVERY – REMOVE AFTER FIXING GOOGLE OAUTH
AUTH_RECOVERY_MODE=false
RECOVERY_ADMIN_EMAIL=
RECOVERY_ADMIN_PASSWORD=
