# URL of the backend API
VITE_API_URL="http://localhost:8000/api/v1"

# Host for the local Ollama service (if interacted with directly from frontend)
VITE_OLLAMA_HOST="http://localhost:11434"

# Default model for the Organizer AI
VITE_ORGANIZER_MODEL_NAME="qwen2.5-coder:1.5b-base"

# Flag to enable debug logging or UI elements
VITE_ENABLE_DEBUG=false
