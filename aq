#!/bin/bash

# Aequitas CLI Wrapper
# Forwards arguments to the backend container's CLI
# Usage: ./aq companies list

COMPOSE_FILE="docker-compose.dev.yml"

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Error: $COMPOSE_FILE not found. Are you in the project root?"
    exit 1
fi

docker compose -f "$COMPOSE_FILE" exec backend python -m cli.main "$@"
