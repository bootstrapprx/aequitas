# Production Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password_securely
POSTGRES_DB=postgres
# Note: The DATABASE_URL is constructed in docker-compose.prod.yml using these variables.
# If you need to override it manually:
# DATABASE_URL=postgresql+psycopg2://postgres:change_this_password_securely@db:5432/postgres

# App Security
SECRET_KEY=change_this_to_a_long_random_string
APP_ENV=production
BACKEND_CORS_ORIGINS=http://localhost,https://yourdomain.com

# AI / Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b-base
ORGANIZER_MODEL_NAME=qwen2.5-coder:1.5b-base

# QuickBooks Online (if used)
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret
QBO_REDIRECT_URI=https://yourdomain.com/api/v1/qbo/callback
